{
  "name": "myblog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A verifiable, AI-themeable personal blog.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "compile": "tsx scripts/compile.ts",
    "prepare-theme": "tsx scripts/prepare-theme.ts",
    "dev": "tsx scripts/dev.ts",
    "build": "tsx scripts/build.ts",
    "preview": "npm --prefix .worktrees/default run preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shikijs/rehype": "4.5.0",
    "gray-matter": "4.0.3",
    "hast-util-to-string": "3.0.1",
    "rehype-autolink-headings": "7.1.0",
    "rehype-raw": "7.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-github-blockquote-alert": "2.1.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.5.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "26.6.5",
    "@types/unist": "^3.0.3",
    "chokidar": "5.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
