---
import type { ContentNode } from '../generated/contract';

interface Props {
  node: ContentNode;
}

const { node } = Astro.props;
---

<div class="detail-meta">
  <time datetime={node.displayDate.iso}>{node.displayDate.iso}</time>
  <span class="node-tag">{node.primaryTag}</span>
  {node.secondaryTags.map((tag) => <span class="node-tag">#{tag}</span>)}
  <span>{node.readingTime} min</span>
  {node.isDirty && <span class="node-badge">有未提交修改</span>}
  {node.isUntracked && <span class="node-badge">文件未提交</span>}
</div>
