---
import type { ContentNode, SiteMeta } from '../generated/contract';
import { buildRevisionPayload } from '../lib/revisions';
import { serializeJson } from '../lib/json';

interface Props {
  node: ContentNode;
  site: SiteMeta;
}

const { node, site } = Astro.props;
const payload = buildRevisionPayload(node, site);
const latest = payload.revisions[0];
const latestAnchor = payload.revisions.find((revision) => revision.anchor);
const json = serializeJson(payload);
---

<details class="revisions" data-revisions>
  <summary>{`修订与存证 · ${payload.revisions.length} 次提交 · ${payload.status}`}</summary>
  <p class="revision-status">{payload.statusDetail}</p>
  {payload.isDirty && <p class="revision-status">当前工作区有未提交修改。</p>}

  <div class="revision-fallback" data-revision-fallback>
    {
      latest ? (
        <>
          <div class="revision-head">
            <span class="revision-index">{latest.label}</span>
            {latest.commitUrl ? (
              <a
                class="revision-commit"
                href={latest.commitUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                <code>{latest.shortCommit}</code>
              </a>
            ) : (
              <code>未提交</code>
            )}
            <time datetime={latest.dateTime}>{latest.timeLabel}</time>
            <span class="revision-changes">
              <span class="diff-add">+{latest.additions}</span>
              <span class="diff-del">−{latest.deletions}</span>
            </span>
          </div>

          <p class="revision-message">{latest.message}</p>

          {latest.blobSha1 && latest.apiUrl && (
            <p class="revision-blob">
              blob SHA-1 <code>{latest.blobSha1}</code>
              <a
                href={latest.apiUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                GitHub API ↗
              </a>
            </p>
          )}

          {latest.anchor ? (
            <p class="revision-anchor">
              <a href={latest.anchor.txUrl} target="_blank" rel="noopener noreferrer">
                交易 {latest.anchor.txShort} ↗
              </a>
              <a
                href={latest.anchor.contractUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                合约 {latest.anchor.contractShort} ↗
              </a>
              <a
                href={latest.anchor.senderUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                签名 {latest.anchor.senderShort} ↗
              </a>
            </p>
          ) : latestAnchor?.anchor ? (
            <p class="revision-anchor">
              当前版本未锚定 · 最近锚定
              <a href={latestAnchor.anchor.txUrl} target="_blank" rel="noopener noreferrer">
                交易 {latestAnchor.anchor.txShort} ↗
              </a>
            </p>
          ) : (
            <p class="revision-anchor">未锚定</p>
          )}

          {latest.anchor && latest.commitUrl && latest.blobUrl && latest.apiUrl && (
            <details class="revision-verify">
              <summary>三步核验</summary>
              <ol>
                <li>
                  链上：打开<a
                    href={latest.anchor.txUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >交易</a>，确认 <code>Anchored</code> 事件的 sender 与 commit。
                </li>
                <li>
                  GitHub：打开<a
                    href={latest.commitUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >commit {latest.shortCommit}</a>与<a
                    href={latest.blobUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >这一版正文</a>，确认内容一致。
                </li>
                <li>
                  比对：<a
                    href={latest.apiUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >GitHub API</a>返回的 <code>sha</code> 应与上面的 <code>{latest.blobSha1}</code> 一致。
                </li>
              </ol>
            </details>
          )}
        </>
      ) : (
        <p class="revision-status">尚无提交记录。</p>
      )
    }
  </div>

  <noscript>
    <p class="revision-noscript">
      完整修订历史需要启用 JavaScript；当前版本的存证链接仍可核验。
    </p>
  </noscript>

  <div data-revision-log hidden></div>
  <script type="application/json" data-revision-data set:html={json}></script>
</details>
