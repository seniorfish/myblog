{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": [
    "core/**/*.ts",
    "host/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "site.config.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    ".worktrees",
    "theme-harness",
    "content"
  ]
}
